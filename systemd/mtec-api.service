[Unit]
Description=EMMA Risk Point API (mtec-risk-alert-system)
# รอเครือข่ายพร้อมก่อน บางทีบูตเสร็จเร็วกว่าเครือข่าย
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mtec-risk-alert-system
# ตั้ง RISK_DATA_FILE และ BOTNOI_TOKEN ที่ /etc/mtec.env
EnvironmentFile=/etc/mtec.env
ExecStart=/usr/bin/python3 -m uvicorn api.server:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
