# mtec.env — ค่าตั้งของ systemd service ทั้งชุด
#
# ติดตั้งไปที่ /etc/mtec.env (ดู scripts/install_services.sh)
# แยกออกมาจากไฟล์ .service เพื่อให้สลับชุดข้อมูล/โดเมนได้โดยไม่ต้องแก้ unit
# แก้ไฟล์นี้แล้วสั่ง  sudo systemctl restart mtec-api mtec-tunnel  พอ ไม่ต้อง daemon-reload
#
# ⚠️ ห้าม commit ไฟล์จริงที่มี token ลง git — commit ได้แค่ไฟล์ .example นี้

# ---- ชุดข้อมูลที่ API จะแจก ----
# สนามทดสอบ สวทช. (จุดสมมติ 8 จุด) — ใช้คู่กับ test-nstda.html และรัศมี 60/80 ม.
RISK_DATA_FILE=data/risk_points_nstda_test.geojson
#
# ใช้งานจริงบนถนน กทม.+ปริมณฑล (456 คลัสเตอร์) — ใช้คู่กับ index.html และรัศมี 500/600 ม.
# RISK_DATA_FILE=data/risk_points_bkk_metro_3y.geojson

# ---- รัศมีเตือนของอุปกรณ์ ----
# ต้องตรงกับที่หน้าเว็บตั้งไว้ ไม่งั้นอุปกรณ์กับแผนที่เตือนคนละระยะ
#   test-nstda.html = 60/80   ·   index.html = 500/600
ALERT_RADIUS_M=60
EXIT_RADIUS_M=80

# ---- เสียงพูด ----
# เว้นว่าง = เปิดเสียงพูด (ค่าเริ่มต้น — เป็นหน้าที่หลักของอุปกรณ์)
# ใส่ --no-speak เมื่อต้องการทดสอบเงียบ ๆ ในห้อง ไม่ให้รบกวนคนอื่น
SPEAK_FLAG=
# ความดังเป็นเปอร์เซ็นต์ · 100 = ไม่ขยายซ้ำ เป็นค่าเดียวที่การันตีว่าไม่มี clipping เลย
# (ไฟล์ใน audio/loud/ อัดจาก Botnoi ที่ 300% มาแล้ว peak ชนเพดานดิจิทัล 1.000
#  การคูณเพิ่มทุกระดับจึงตัดยอดคลื่นทันที)
#
# 200 = ที่ใช้จริงตอนทดสอบภาคสนาม (2026-08-27) เพราะกลางแจ้งและมีเสียงเครื่องยนต์
# ระดับ 100 ดังไม่พอ · แลกกับพยางค์ที่ดังกว่าค่าเฉลี่ยมาก ๆ เริ่มแตกเล็กน้อย
# ซึ่งยอมรับได้เพราะเป็นเสียงพูดเตือน ไม่ใช่เสียงดนตรี — ความชัดสำคัญกว่าความใส
#
# ถ้าเปลี่ยนไปใช้ไฟล์เสียงชุดใหม่ที่อัดจาก Botnoi ระดับอื่น ต้องวัด peak/rms ใหม่
# ด้วย scripts/measure_audio_headroom.py แล้วทบทวนค่านี้ ไม่งั้นอาจแตกหนักกว่านี้มาก
VOLUME_PCT=200

# ---- โดเมนสาธารณะคงที่สำหรับดูจากมือถือ ----
# ต้องเป็นโดเมน "คงที่" ไม่ใช่ URL สุ่มแบบ trycloudflare เพราะเวลาออกภาคสนาม
# ไม่มีจอให้อ่าน URL ใหม่ — ต้อง bookmark ไว้ในมือถือครั้งเดียวแล้วใช้ได้ตลอด
#
# สมัคร ngrok ฟรี (ได้โดเมนคงที่ 1 ชื่อ) ที่ https://dashboard.ngrok.com
#   1. Your Authtoken   -> เอามาใส่ NGROK_AUTHTOKEN
#   2. Domains -> New Domain -> เอาชื่อที่ได้มาใส่ NGROK_DOMAIN
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
