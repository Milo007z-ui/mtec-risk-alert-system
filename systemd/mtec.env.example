# ค่าตั้งของ systemd service ทั้งชุด — คัดลอกไปเป็น /etc/mtec.env แล้วแก้ค่า

# ชุดข้อมูลที่ API แจก (สนามทดสอบ สวทช. · ใช้งานจริงใช้ risk_points_bkk_metro_3y.geojson)
RISK_DATA_FILE=data/risk_points_nstda_test.geojson

# รัศมีเตือนของอุปกรณ์ ต้องตรงกับหน้าเว็บที่เปิดดู (สนามทดสอบ 60/80 · ถนนจริง 500/600)
ALERT_RADIUS_M=60
EXIT_RADIUS_M=80

# เว้นว่าง = เปิดเสียงพูด · ใส่ --no-speak = เหลือแต่ beep
SPEAK_FLAG=
# ความดังเป็นเปอร์เซ็นต์ · 100 = ไม่ขยายซ้ำ เกินกว่านั้นดังขึ้นแต่เริ่มแตก
VOLUME_PCT=200

# โดเมนคงที่สำหรับเปิดดูจากมือถือนอกวง WiFi (เว้นว่างได้ ระบบทำงานปกติ)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
