[Unit]
Description=EMMA Pi Alert Client (mtec-risk-alert-system) - ใช้งานจริงกับ GPS
# ต้องรอ mtec-api.service ให้เปิดพอร์ต 8000 เสร็จก่อน ไม่งั้นเชื่อมต่อไม่ติดตั้งแต่ต้น
After=mtec-api.service
Requires=mtec-api.service

[Service]
# ตัวรับ GPS USB ใช้เวลาสักครู่กว่าเคอร์เนลจะสร้างไฟล์พอร์ตให้หลังบูต
# ถ้า service เริ่มก่อน จะหาพอร์ตไม่เจอแล้ว exit — Restart=on-failure ด้านล่าง
# จะพาให้ลองใหม่ทุก 5 วิ จนกว่าจะเจอ จึงไม่ต้องใส่ ExecStartPre รออะไรเพิ่ม

Type=simple
User=pi
# ต้องอยู่กลุ่ม dialout ถึงจะอ่าน /dev/ttyACM0 หรือ /dev/ttyUSB0 ของตัวรับ GPS ได้
# (รันมือได้แต่ service อ่านไม่ได้ = สาเหตุนี้เกือบทุกครั้ง)
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/mtec-risk-alert-system
# --serial = อ่านพิกัดจากตัวรับ GPS USB (Beltian BE-609U) โดยตรง ไม่ผ่าน gpsd
#            หาพอร์ตให้อัตโนมัติ ถ้าเสียบ USB serial หลายตัวจนหาผิด ระบุเองได้:
#            --serial /dev/ttyUSB0   (ดูรายการจริงด้วย ls -l /dev/serial/by-id/)
#            โหมดนี้ยังส่งพิกัดขึ้น /api/device/location ให้เว็บวาดหมุดรถเรียลไทม์ด้วย
# ปรับ --audio-device ให้ตรงกับเลขการ์ดของเครื่อง เช็คด้วย aplay -l
#
# ไม่ต้องใส่ --volume: ค่าเริ่มต้นในโค้ดคือ 100 = ไม่ขยายสัญญาณซ้ำ เสียงไม่แตก
# (ไฟล์ใน audio/loud/ อัดจาก Botnoi ที่ 300% มาแล้ว peak=1.000 จึงดังพออยู่แล้ว)
# ถ้าติดตั้งบนรถจริงแล้วเสียงเครื่องยนต์กลบ ค่อยเติม --volume 200 ตรงนี้
# แล้ว daemon-reload + restart — ยิ่งเกิน 100 มาก ยิ่งแตกมาก
ExecStart=/usr/bin/python3 device/pi_alert_client.py --api http://localhost:8000 --serial --audio-device plughw:2,0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
