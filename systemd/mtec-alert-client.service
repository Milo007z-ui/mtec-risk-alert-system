[Unit]
Description=EMMA Pi Alert Client (mtec-risk-alert-system) - ใช้งานจริงกับ GPS
# ต้องรอ API เปิดพอร์ต 8000 ก่อน ไม่งั้นเชื่อมต่อไม่ติดตั้งแต่ต้น
After=mtec-api.service
Requires=mtec-api.service

[Service]
Type=simple
User=pi
# ต้องอยู่กลุ่ม dialout ถึงจะอ่านพอร์ต GPS ได้ (รันมือได้แต่ service ไม่ได้ = สาเหตุนี้)
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/mtec-risk-alert-system
# รัศมี ความดัง เปิด/ปิดเสียงพูด แก้ที่ /etc/mtec.env ที่เดียว
EnvironmentFile=/etc/mtec.env
# ฆ่าไคลเอนต์ตัวเก่าที่ค้างอยู่ก่อนเสมอ กันสองตัวแย่งกันส่งพิกัดจนหมุดกระโดด
ExecStartPre=-/usr/bin/pkill -f "pi_alert_client.py"
# --serial = อ่าน NMEA จากตัวรับ GPS โดยตรง ไม่ต้องมี gpsd
ExecStart=/usr/bin/python3 device/pi_alert_client.py --api http://localhost:8000 --serial --audio-device plughw:2,0 --alert-radius ${ALERT_RADIUS_M} --exit-radius ${EXIT_RADIUS_M} --volume ${VOLUME_PCT} $SPEAK_FLAG
# หาพอร์ต GPS ไม่เจอตอนเพิ่งบูต = ลองใหม่ทุก 5 วิ จนกว่าเคอร์เนลจะสร้างไฟล์พอร์ตให้
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
